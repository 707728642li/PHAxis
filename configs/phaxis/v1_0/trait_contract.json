      "unit": "count",
      "type": "integer_or_null",
      "source": "count valid Stage B attachments in [1000,4000) um"
    },
    {
      "id": "H09",
      "field": "local_hair_density_per_mm_1_4mm",
      "display_name_cn": "distal 1--4 mm 窗口根毛密度",
      "display_name_en": "Root-hair identity density in the distal [1,4) mm window",
      "unit": "count_per_mm",
      "type": "number_or_null",
      "source": "local_hair_count_1_4mm / 3"
    },
    {
      "id": "H10",
      "field": "local_mean_hair_length_um_1_4mm",
      "display_name_cn": "1--4 mm 窗口平均根毛长度",
      "display_name_en": "Conditional mean hair length in the distal [1,4) mm window",
      "unit": "um",
      "type": "number_or_null",
      "source": "mean length_hairs matched to Stage B identities attached in [1000,4000) um"
    },
    {
      "id": "H11",
      "field": "local_median_hair_length_um_1_4mm",
      "display_name_cn": "1--4 mm 窗口中位根毛长度",
      "display_name_en": "Conditional median hair length in the distal [1,4) mm window",
      "unit": "um",
      "type": "number_or_null",
      "source": "median length_hairs matched to Stage B identities attached in [1000,4000) um"
    },
    {
      "id": "H12",
      "field": "local_total_hair_length_um_per_root_mm_1_4mm",
      "display_name_cn": "1--4 mm 单位根长已测总长度",
