      "unit": "um",
      "type": "number_or_null",
      "source": "minimum Stage B attachment distance among one-to-one matched length_hairs with length >=40 um"
    },
    {
      "id": "H08",
      "field": "local_hair_count_1_4mm",
      "display_name_cn": "distal 1--4 mm 窗口根毛数",
